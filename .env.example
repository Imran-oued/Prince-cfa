# ========================================================
# Prince CFA Mall - Configuration des Variables d'Environnement
# ========================================================

# --- Identifiants Publics Firebase Client (Optionnels si tout transite par le serveur) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=prince-cfa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Identifiants Serveur Firebase Admin SDK (STRICTEMENT REQUIS EN PRODUCTION) ---
# Option 1 (Recommandée sur Hostinger) : Variables distinctes
FIREBASE_PROJECT_ID=prince-cfa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@prince-cfa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Option 2 (Alternative) : Contenu JSON complet du compte de service (chaîne minifiée)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"prince-cfa",...}'

# --- Sécurité Administration ---
# Mot de passe administrateur (obligatoire en production, min. 8 caractères, distinct de "admin")
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
# Clé secrète de signature des sessions JWT HMAC-SHA256 (recommandé : 32+ caractères aléatoires)
ADMIN_JWT_SECRET=generate_a_random_32_characters_secret_key_here

# --- Notifications Web Push (VAPID) ---
# Clé publique (utilisée par le navigateur pour souscrire)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKoj_69RaUCQNGXnhDd1SWI4X10dPEoqQpWuNxSaEVZkgYr4MfGtfsXMAASPiUL96vVr-GEMESngy0-Y0bIEZpw
# Clé privée (STRICTEMENT SERVEUR, requise pour l'envoi des notifications push)
VAPID_PRIVATE_KEY=jZ_kBPAaVYv7o_ztzEd3mpcFhvrlZl11ou1i4pA1g0c
# Contact sujet VAPID
VAPID_SUBJECT=mailto:contact@prince-cfa.com
